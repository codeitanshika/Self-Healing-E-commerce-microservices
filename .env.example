# ── LLM (Groq free tier) ─────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── Backend ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Seconds between Monitor Agent health sweeps
MONITOR_POLL_INTERVAL=5
# If set, mutating endpoints (fault injection, manual heal) require
# the header "X-API-Key: <this value>". Leave empty for open local demos.
API_KEY=
# 1 (default): only a fix that suits the fault cures it, so a wrong choice is
# retried or escalated. 0: any fix cures any fault.
STRICT_HEALING=1
# distinct (default): each retry tries a new fix. repeat: reuse the mapped
# retry fix (how the published experiments were recorded).
RETRY_POLICY=distinct

# ── Frontend (put in frontend/.env.local) ────────────────────────
# VITE_API_URL=http://localhost:8000
# VITE_API_KEY=
